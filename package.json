{
  "name": "jotai-sync-scope",
  "version": "1.0.0",
  "description": "Sync Jotai atoms across scope boundaries",
  "keywords": [
    "jotai",
    "react",
    "scope",
    "sync"
  ],
  "license": "MIT",
  "author": "Andrey Kiselev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAsda/jotai-sync-scope.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pkgroll --sourcemap",
    "cosmos": "cosmos",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "bun run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.1",
    "jotai": "^2.20.0",
    "jsdom": "^29.1.1",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "pkgroll": "^2.27.0",
    "react": "^18.3.1",
    "react-cosmos": "^7.3.0",
    "react-cosmos-plugin-vite": "^7.3.0",
    "react-dom": "^18.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "peerDependencies": {
    "jotai": "^2",
    "react": "^18 || ^19"
  },
  "engines": {
    "node": ">=18"
  }
}
